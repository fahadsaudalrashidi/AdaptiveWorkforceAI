modules = ["python-3.12", "nodejs-20", "web", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["arrow-cpp", "cargo", "dejavu_fonts", "glibcLocales", "libiconv", "libxcrypt", "ocl-icd", "openssl", "pkg-config", "postgresql", "rapidfuzz-cpp", "rustc", "taskflow", "tesseract", "xsimd"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AWI frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AWI backend"

[[workflows.workflow]]
name = "AWI frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd executive-ui && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "AWI backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m uvicorn backend.api.main:create_app --factory --host 127.0.0.1 --port 8000"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5050
externalPort = 3000

[postMerge]
path = "post-merge.sh"
timeoutMs = 300000

[deployment]
deploymentTarget = "vm"
run = ["bash", "start-production.sh"]
build = ["bash", "build-production.sh"]

[userenv]

[userenv.shared]
THRIVE_NEW_ADMIN_USERNAME = "admin02"
