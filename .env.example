# Adaptive Workforce AI — Environment Variable Template
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# NEVER use real credentials in this file.

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Options: development | staging | production
# In production, ensure DEBUG is never set to True.

LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
# In production, use INFO or WARNING only.

# ── API Server ────────────────────────────────────────────────────────────────
API_PORT=8000
API_HOST=0.0.0.0

# ── Storage Paths ─────────────────────────────────────────────────────────────
ARTIFACT_STORE_PATH=./data/artifacts
AUDIT_LOG_PATH=./data/audit_logs
MODEL_STORE_PATH=./saved_models

# ── Authentication (production only) ─────────────────────────────────────────
# JWT_SECRET_KEY=REPLACE_WITH_SECURE_KEY_IN_PRODUCTION
# JWT_ALGORITHM=RS256
# JWT_EXPIRY_SECONDS=3600

# ── Database (optional — required for production audit persistence) ────────────
# POSTGRES_DB=workforce_ai
# POSTGRES_USER=REPLACE_IN_PRODUCTION
# POSTGRES_PASSWORD=REPLACE_IN_PRODUCTION
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ── Redis (optional — required for job queue in production) ───────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Saudi compliance ──────────────────────────────────────────────────────────
SAUDI_COMPLIANCE_MODE=true
PDPL_WARNING_ENABLED=true

# ── Streamlit (optional demo) ─────────────────────────────────────────────────
# STREAMLIT_PORT=8501

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION SECURITY NOTES:
#
# 1. Never set DEBUG=True in production.
# 2. JWT_SECRET_KEY must be a cryptographically secure random key (≥256 bits).
# 3. POSTGRES_PASSWORD must meet your organization's password policy.
# 4. All secrets must be managed via a secrets vault (AWS Secrets Manager,
#    Azure Key Vault, HashiCorp Vault) in production — not environment files.
# 5. Data must be stored in a Saudi data center for PDPL compliance unless
#    SDAIA cross-border transfer approval has been obtained.
# ─────────────────────────────────────────────────────────────────────────────
